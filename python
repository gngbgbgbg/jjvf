import time
import random

# استفاده از impersonated session برای شبیه‌سازی کامل مرورگر واقعی
try:
    from curl_cffi import requests
except ImportError:
    import requests

class RenderX3UIClient:
    def __init__(self, base_url, username, password):
        self.base_url = base_url.rstrip('/')
        self.username = username
        self.password = password
        
        # ایجاد نشست با هویت کامل مرورگر Chrome 120
        # این بخش باعث دور زدن شناسایی فایروال روی Render می‌شود
        self.session = requests.Session(impersonate="chrome120")
        
        self.headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            "Accept": "application/json, text/plain, */*",
            "Accept-Language": "fa-IR,fa;q=0.9,en-US;q=0.8,en;q=0.7",
            "Content-Type": "application/json",
            "Origin": self.base_url,
            "Referer": f"{self.base_url}/panel/",
            "Sec-Ch-Ua": '"Not_A Brand";v="8", "Chromium";v="120", "Google Chrome";v="120"',
            "Sec-Ch-Ua-Mobile": "?0",
            "Sec-Ch-Ua-Platform": '"Windows"',
            "Sec-Fetch-Dest": "empty",
            "Sec-Fetch-Mode": "cors",
            "Sec-Fetch-Site": "same-origin"
        }

    def login(self):
        login_url = f"{self.base_url}/login"
        payload = {
            "username": self.username,
            "password": self.password
        }
        
        try:
            # تاخیر برای جلوگری از Rate Limit روی Render
            time.sleep(random.uniform(1.0, 2.5))
            
            # ارسال درخواست لاگین
            response = self.session.post(
                login_url, 
                json=payload, 
                headers=self.headers,
                timeout=20, # تایم‌اوت بالاتر برای لود اول Render
                verify=False
            )
            
            if response.status_code == 200:
                res_data = response.json()
                if res_data.get("success"):
                    print("[+] (Render) لاگین با موفقیت انجام شد.")
                    return True
                else:
                    print(f"[-] لاگین ناموفق: {res_data.get('msg')}")
            else:
                print(f"[-] خطای HTTP روی Render. کد وضعیت: {response.status_code}")
                # اگر 403 داد، یعنی آی‌پی Render مسدود شده است
                if response.status_code == 403:
                    print("[!] آی‌پی سرور Render توسط فایروال مقصد بلاک شده است.")
                    
        except Exception as e:
            print(f"[-] خطای ارتباطی روی Render: {e}")
            
        return False

    def get_inbounds(self):
        url = f"{self.base_url}/panel/api/inbounds/list"
        time.sleep(random.uniform(1.5, 3.0))
        
        try:
            response = self.session.get(url, headers=self.headers, timeout=20, verify=False)
            if response.status_code == 200:
                data = response.json()
                if data.get("success"):
                    return data.get("obj")
            elif response.status_code in [401, 403]:
                print("[!] کوکی منقضی شده یا دسترسی مسدود شد. تلاش مجدد...")
                if self.login():
                    return self.get_inbounds()
        except Exception as e:
            print(f"[-] خطای دریافت دیتا: {e}")
            
        return None

# --- تست اسکریپت ---
if __name__ == "__main__":
    PANEL_URL = "https://YOUR_PANEL_DOMAIN_OR_IP:2053"
    USERNAME = "admin"
    PASSWORD = "your_password"

    client = RenderX3UIClient(PANEL_URL, USERNAME, PASSWORD)
    if client.login():
        data = client.get_inbounds()
        if data:
            print(f"[+] تعداد {len(data)} اینباند دریافت شد.")
